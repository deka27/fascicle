{
  "family": "fascicle",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "2048",
  "runtimePlatform": {"cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX"},
  "executionRoleArn": "arn:aws:iam::008402585108:role/fascicle-task-execution",
  "containerDefinitions": [
    {
      "name": "fascicle",
      "image": "008402585108.dkr.ecr.us-east-2.amazonaws.com/fascicle:5a2bf09",
      "essential": true,
      "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
      "environment": [{"name": "DEEPSEEK_MODEL", "value": "deepseek-reasoner"}],
      "secrets": [
        {"name": "DEEPSEEK_API_KEY", "valueFrom": "arn:aws:ssm:us-east-2:008402585108:parameter/fascicle/deepseek-api-key"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {"awslogs-group": "/ecs/fascicle", "awslogs-region": "us-east-2", "awslogs-stream-prefix": "app"}
      }
    }
  ]
}
